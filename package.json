{
  "name": "@appcircle/cli",
  "version": "3.0.0-alpha.0",
  "description": "CLI tool for running Appcircle services from the command line",
  "main": "bin/appcircle.js",
  "bin": {
    "appcircle": "bin/appcircle.js"
  },
  "scripts": {
    "watch": "rm -rf dist && tsc -w",
    "build": "rm -rf dist && tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "update-badges": "bash scripts/update-badges-local.sh",
    "postversion": "git push && git push --tags",
    "postuninstall": "node ./scripts/appcircle-uninstall.js",
    "check:package": "node ./scripts/check-package.mjs",
    "bump:version:beta": "npm version prerelease --preid=beta",
    "bump:version:alpha": "npm version prerelease --preid=alpha",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appcircleio/appcircle-cli.git"
  },
  "keywords": [
    "appcircle",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Appcircle",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/appcircleio/appcircle-cli/issues"
  },
  "homepage": "https://github.com/appcircleio/appcircle-cli#readme",
  "dependencies": {
    "axios": "^1.21.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "conf": "^16.0.0",
    "enquirer": "^2.3.6",
    "env-paths": "2.2.1",
    "form-data": "^4.0.0",
    "jsonfile": "^6.2.1",
    "minimist": "^1.2.6",
    "moment": "^2.31.0",
    "ora": "^10.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/"
  ],
  "devDependencies": {
    "@types/jsonfile": "^6.1.4",
    "@types/minimist": "^1.2.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "msw": "^3.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "5.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
